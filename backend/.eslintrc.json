{
  "root": true,
  "env": {
    "node": true,
    "es2022": true,
    "mocha": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^next$", "ignoreRestSiblings": true }],
    "eqeqeq": "error",
    "no-console": "off",
    "no-process-exit": "off"
  }
}
